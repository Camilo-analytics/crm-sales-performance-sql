    <worksheet name='Scatter'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>Agent Performance: Revenue vs Pricing</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='sales_pipeline_clean+' name='federated.0sc0y851w3yuxj113nvbp01u8gsh' />
          </datasources>
          <datasource-dependencies datasource='federated.0sc0y851w3yuxj113nvbp01u8gsh'>
            <column caption='Performance Category' datatype='string' name='[Calculation_1420347006791680]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([close_value]) &gt;= WINDOW_AVG(SUM([close_value]))&#10;AND AVG([sales_price]) &gt;= WINDOW_AVG(AVG([sales_price]))&#10;THEN &quot;Top Performer&quot;&#10;&#10;ELSEIF SUM([close_value]) &gt;= WINDOW_AVG(SUM([close_value]))&#10;THEN &quot;High Revenue / Low Price&quot;&#10;&#10;ELSEIF AVG([sales_price]) &gt;= WINDOW_AVG(AVG([sales_price]))&#10;THEN &quot;High Price / Low Revenue&quot;&#10;&#10;ELSE &quot;Low Performer&quot;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
